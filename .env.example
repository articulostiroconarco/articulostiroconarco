# Configuración General (Vercel / Next.js)
NEXT_PUBLIC_SITE_URL=https://tu-dominio.vercel.app
APP_NAME="Artículos de Tiro con Arco"

# Conexión Supabase (PostgreSQL + Auth + RLS)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-publishable-o-anon-key

# Seguridad Anti-CSRF (cadena aleatoria larga de al menos 32 caracteres)
CSRF_SECRET=reemplazar-por-secreto-aleatorio-seguro

# Notificaciones por Correo con Resend API (Opcional: si se deja vacío, la consulta se guarda igualmente en Supabase)
RESEND_API_KEY=
MAIL_FROM_ADDRESS=onboarding@resend.dev
MAIL_FROM_NAME="Artículos Tiro con Arco"
ADMIN_NOTIFICATION_EMAIL=damiajr@hotmail.com
